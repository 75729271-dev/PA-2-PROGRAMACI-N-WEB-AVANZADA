# Copiar este archivo como .env y completar los valores. El .env NO se sube a GitHub.
PORT=3000

# MongoDB local o MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/solicitudes_academicas

# Clave para firmar los JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# Orígenes del frontend autorizados por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Usuario administrativo inicial creado por "npm run seed"
ADMIN_EMAIL=admin@isil.test
ADMIN_PASSWORD=
