{
  "info": {
    "name": "PA2 - API Solicitudes Académicas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden. Primero correr \"npm run seed\" para tener el usuario administrativo."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenEstudiante",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "idSolicitud",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Servidor",
      "item": [
        {
          "name": "Estado de la API",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        }
      ]
    },
    {
      "name": "2. Autenticación",
      "item": [
        {
          "name": "Registrar estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) pm.collectionVariables.set('tokenEstudiante', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana Torres\",\n  \"email\": \"ana.torres@isil.test\",\n  \"password\": \"clave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login estudiante",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) pm.collectionVariables.set('tokenEstudiante', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.torres@isil.test\",\n  \"password\": \"clave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login administrativo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) pm.collectionVariables.set('tokenAdmin', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@isil.test\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Perfil (ruta protegida)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "perfil"
              ]
            }
          }
        },
        {
          "name": "Sin token (debe dar 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. CRUD Solicitudes",
      "item": [
        {
          "name": "Crear solicitud (estudiante)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.solicitud) pm.collectionVariables.set('idSolicitud', r.solicitud._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Retiro de curso\",\n  \"asunto\": \"Retiro de Cálculo\",\n  \"descripcion\": \"Solicito el retiro del curso por cruce con mi horario laboral.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar mis solicitudes (estudiante)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            }
          }
        },
        {
          "name": "Ver una solicitud",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}"
              ]
            }
          }
        },
        {
          "name": "Editar solicitud pendiente (estudiante)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asunto\": \"Retiro de Cálculo (sección B)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar todas (administrativo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ]
            }
          }
        },
        {
          "name": "Filtrar por estado (administrativo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes?estado=Pendiente",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "Pendiente"
                }
              ]
            }
          }
        },
        {
          "name": "Cambiar estado (administrativo)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Aprobada\",\n  \"respuesta\": \"Retiro procesado por Mesa de Partes.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cambiar estado como estudiante (403)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Aprobada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar solicitud (administrativo)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/solicitudes/{{idSolicitud}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "solicitudes",
                "{{idSolicitud}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Usuarios (administrativo)",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Listar usuarios como estudiante (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            }
          }
        }
      ]
    }
  ]
}
